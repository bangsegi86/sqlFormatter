{
  "name": "oracle-sql-formatter",
  "version": "1.0.0",
  "description": "Oracle SQL 쿼리 포매터 (포터블 데스크톱 앱)",
  "main": "main.js",
  "private": true,
  "author": "Oracle SQL Formatter",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/engine.test.js",
    "icon": "node tools/make-icon.js",
    "build:editor": "esbuild tools/editor-entry.js --bundle --format=iife --global-name=CM --minify --target=chrome120 --outfile=src/vendor/codemirror.js --banner:js=\"/* CodeMirror 6 - MIT License (c) Marijn Haverbeke and others - https://codemirror.net */\"",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "local.oracle.sqlformatter",
    "productName": "OracleSqlFormatter",
    "files": [
      "main.js",
      "package.json",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "compression": "maximum",
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "OracleSqlFormatter-${version}-portable.exe"
    }
  }
}
